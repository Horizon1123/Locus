+#[cfg(test)]
+mod locus_timeout_tests {
+    use super::*;
+    use std::sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    };
+
+    struct BorrowGuard(Arc<AtomicBool>);
+    impl Drop for BorrowGuard {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::SeqCst);
+        }
+    }
+
+    #[test]
+    fn locus_timeout_drops_inflight_future_before_ffi_returns() {
+        let dropped = Arc::new(AtomicBool::new(false));
+        let flag = dropped.clone();
+        let result: Result<(), IdeviceError> = run_sync(async move {
+            run_global_timeout(|| async move {
+                let _borrow = BorrowGuard(flag);
+                std::future::pending::<Result<(), IdeviceError>>().await
+            })
+            .await
+        });
+        assert!(matches!(result, Err(IdeviceError::Timeout)));
+        assert!(dropped.load(Ordering::SeqCst));
+        // A timed-out operation must not block the next queued operation.
+        let result: Result<u8, IdeviceError> =
+            run_sync(async { run_global_timeout(|| async { Ok::<_, IdeviceError>(42) }).await });
+        assert_eq!(result.unwrap(), 42);
+    }
+}
+
+/// Build marker used by Locus to require the bounded-operation library.
+#[unsafe(no_mangle)]
+pub extern "C" fn locus_idevice_timeout_patch_version() -> u32 {
+    1
+}
